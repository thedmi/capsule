{
    "name": "Capsule",

    // Capsule is a pure .NET library (no external service dependencies), so we run
    // a plain SDK image rather than a Docker Compose stack. The image tag matches
    // the newest target framework (net10.0); the older TFMs build via the same SDK.
    "image": "mcr.microsoft.com/devcontainers/dotnet:2-10.0-noble",

    "workspaceFolder": "/workspace",
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",

    // Set the user the container will run as
    "remoteUser": "vscode",

    // Automatically update the container user's UID/GID to match your local user
    "updateRemoteUserUID": true,

    "features": {
        "ghcr.io/devcontainers/features/node:1": { "version": "lts" }
    },

    "mounts": [
        "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind,consistency=cached",
        "source=${localEnv:HOME}/.claude.json,target=/home/vscode/.claude.json,type=bind,consistency=cached",
        "source=${localEnv:HOME}/.nuget/packages,target=${localEnv:HOME}/.nuget/packages,type=bind,consistency=cached"
    ],

    "containerEnv": {
        "TERM": "xterm-256color",
        "NUGET_PACKAGES": "${localEnv:HOME}/.nuget/packages"
    },

    "postCreateCommand": "git config --global --add safe.directory /workspace && npm i -g @anthropic-ai/claude-code && dotnet tool restore && dotnet husky install",

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-dotnettools.csdevkit",
                "ms-dotnettools.csharp",
                "editorconfig.editorconfig",
                "csharpier.csharpier-vscode"
            ]
        }
    }
}
